# Copy to .env. Every value has a zero-infra default; leave it empty to run without keys, Docker or Postgres.

# LLM: "fake" = deterministic semantic compiler (no network), "openai" = any OpenAI-compatible chat API
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=

# Embeddings for the dense half of hybrid retrieval: "hash" (no network) or "openai"
EMBEDDING_PROVIDER=hash

# Warehouse. Default: SQLite file in data/. Production: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=
# "memory", "pgvector" (needs a Postgres DATABASE_URL) or "milvus" (Milvus Lite file by default; or a server / Zilliz URI)
VECTOR_BACKEND=memory
MILVUS_URI=
MILVUS_TOKEN=

# Reranker over the fused candidates: "lexical" (deterministic, default), "flashrank" (local cross-encoder,
# pip install flashrank), "llm" (model-scored, needs LLM_API_KEY) or "none"
RERANKER=lexical

# Answer cache: "memory" (per process) or redis://host:6379/0 (shared across replicas). TTL in seconds.
CACHE_URL=memory
CACHE_TTL_S=3600

# Pin the as-of date for relative time ("last quarter"); empty = latest order date in the warehouse
AS_OF_DATE=

LLM_REASONING_EFFORT=low
# Leave unset for reasoning models (they accept only their default)
LLM_TEMPERATURE=
# If the model path raises at runtime, answer with the deterministic compiler and say so (never cached)
LLM_FALLBACK_TO_FAKE=true

HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public-exposure controls (0 disables). Behind Render / one reverse proxy set TRUSTED_PROXY_HOPS=1.
TRUSTED_PROXY_HOPS=0
VISITOR_PER_MINUTE=8
VISITOR_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=400
# Protects /runs (question logs). Empty = open, for local development only.
ADMIN_TOKEN=
SECRET_SALT=change-me
